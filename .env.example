# ---- Required to view submissions ----------------------------------------
# Any long random string. You'll use it to open /admin?token=THIS
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---- Database -------------------------------------------------------------
# Railway sets this automatically when you add a PostgreSQL service.
# Leave empty locally and submissions are written to data/enquiries.json
DATABASE_URL=

# ---- Optional: email me on every new enquiry ------------------------------
# Example for Gmail: create an App Password, then:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
NOTIFY_FROM=
