# ---- Admin login (email + password) ---------------------------------------
# The password is never stored in plain text — only its scrypt hash.
# Generate a hash for a new password with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync('YOUR-PASSWORD',s,64).toString('hex'))"
ADMIN_EMAIL=admin@relay.com
ADMIN_PASSWORD_HASH=
# Signs the login session cookie — any long random string
SESSION_SECRET=

# ---- Optional: token access for scripts/CSV automation --------------------
# Lets you call /api/enquiries.csv?token=THIS without signing in
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---- Database -------------------------------------------------------------
# Railway sets this automatically when you add a PostgreSQL service.
# Leave empty locally and submissions are written to data/enquiries.json
DATABASE_URL=

# ---- Optional: email me on every new enquiry ------------------------------
# Example for Gmail: create an App Password, then:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
NOTIFY_FROM=
